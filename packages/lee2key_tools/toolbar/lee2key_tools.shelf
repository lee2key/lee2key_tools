  <tool name="lk_newmat_scaletexture" label="New mat / Scale texture" icon="PLASMA_App">
    <script scriptType="python"><![CDATA[# Get context where we are now
network = hou.ui.curDesktop().paneTabOfType(hou.paneTabType.NetworkEditor)
current_node_path = network.pwd().path()
context = hou.node(current_node_path)




sel = hou.selectedNodes()
if sel:
    rs_abs = context.createNode("redshift::RSMathAbs", "Scale_Textures")
    network = hou.ui.curDesktop().paneTabOfType(hou.paneTabType.NetworkEditor)
    cursor_position = network.cursorPosition()
    cursor_position[0] -= 0.5
    rs_abs.setPosition(cursor_position)
    
    i = 0
    for node in sel:
        sel[i].setInput(0, rs_abs)
        i += 1
else:
    # Open input dialog for naming Null
    mat_name = hou.ui.readInput("Enter name", 
                                buttons=("OK", "Cancel"),
                                default_choice=0,
                                close_choice=1,
                                title="New Material",
                                initial_contents="Mat_1")[1]
    mat_name = mat_name.replace(" ", "_")
    
    rs_mat = context.createNode("redshift_vopnet", mat_name)
    cursor_position = network.cursorPosition()
    cursor_position[0] -= 0.5
    rs_mat.setPosition(cursor_position)]]></script>
  </tool>

